{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "docs",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
